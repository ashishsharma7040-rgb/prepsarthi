<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon — required for Android 8.0+ (API 26) and Play Store.
  Without this file, the launcher icon appears as a plain square on modern devices
  and fails Google Play icon policy checks.

  foreground → drawable/ic_launcher_foreground (your logo/symbol, 108×108dp safe zone)
  background → drawable/ic_launcher_background (solid/gradient fill)
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
